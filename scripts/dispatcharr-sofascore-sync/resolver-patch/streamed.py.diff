+def _validated_stream_url(raw_url: str | None) -> str:
+    """Reject malformed or non-HTTP playback URLs before minting a handle."""
+    candidate = str(raw_url or "").strip().strip("\"'")
+    try:
+        parsed = urlsplit(candidate)
+        if parsed.scheme.lower() not in {"http", "https"} or not parsed.hostname:
+            raise ValueError("unsupported playback URL")
+        # httpx catches malformed ports, escapes, and other URL syntax that
+        # urlsplit intentionally accepts for compatibility.
+        httpx.URL(candidate)
+    except (ValueError, httpx.InvalidURL) as exc:
+        raise PlaybackResolutionError("resolved stream has an invalid playable location") from exc
+    return candidate
+
