# Keep sanitized examples/templates trackable
!.env.example
!*.env.example
!*.env.template
!templates/**/*.env.template
!.browser-harness.env.example
!templates/.browser-harness.env.template

# Browser harness project-local runtime state
.browser-harness/

# Local pi/agent state
.pi/
.pi-subagents/

# Agent run artifacts. These capture prompts and transcripts from whatever task
# was running, which routinely includes absolute home paths and unrelated
# project context. Keep them out of the repo.
commit.json
report.md
