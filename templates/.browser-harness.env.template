# Copy to .browser-harness.env and edit per project.
# Do not reuse the same container name, port, BU_NAME, or profile volume across projects.

BH_PROJECT_SLUG=my-app
BH_CONTAINER_NAME=bh-my-app
BH_IMAGE=browser-harness-patchright:1.61.1

# Bind container CDP to host loopback only.
BH_HOST_PORT=19322

# browser-harness daemon name. Must match [A-Za-z0-9_-]{1,64}.
BH_BU_NAME=my-app

# Persistent Chrome profile for this project only.
BH_PROFILE_VOLUME=bh-my-app-profile

# Host-visible downloads from the container browser.
BH_DOWNLOADS_DIR=.browser-harness/downloads

# Docker Desktop-friendly default. On native Linux, --ipc=host is often better for Chromium.
BH_DOCKER_EXTRA_ARGS=--shm-size=2g

# 0 = headed Chrome under Xvfb; 1 = Chrome headless.
PATCHRIGHT_HEADLESS=0

# Optional informational canonical HTTP(S) origin. Reported by status; never auto-navigated.
# BH_BROWSER_ORIGIN=https://localhost:3443

# Optional dedicated Chromium resolver rules. Quote spaces; do not duplicate in PATCHRIGHT_EXTRA_ARGS.
# BH_HOST_RESOLVER_RULES='MAP localhost host.docker.internal'

# Optional extra Chrome args. Keep minimal.
# Examples:
# PATCHRIGHT_EXTRA_ARGS=--lang=en-US
# PATCHRIGHT_EXTRA_ARGS=--proxy-server=http://host.docker.internal:8080
PATCHRIGHT_EXTRA_ARGS=

# Optional stronger sandbox path. Requires compatible Docker/seccomp config.
CHROMIUM_SANDBOX=0

# Optional loopback-only VNC view of the container display, for one-time
# interactive work an agent must not do for you (service sign-in, captcha).
# Requires headed Chrome. Leave unset when not in use.
# BH_VNC_PORT=15900

# Optional steipete/oracle consults through this container (./scripts/oracle).
# Workflow defaults live in .oracle/config.json; the CDP target is always
# 127.0.0.1:${BH_HOST_PORT}.
# BH_ORACLE_MODEL=gpt-5.5-pro
# BH_ORACLE_EXTRA_ARGS=--heartbeat 30
