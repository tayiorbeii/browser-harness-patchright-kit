# Browser Harness project identity example.
# Copy to .browser-harness.env for local use; never commit the local copy.
# Keep container name, host port, BU_NAME, and profile volume unique per project.

# Stable project slug used by labels, names, and browser-harness state.
BH_PROJECT_SLUG=my-app

# Docker container name for this project's browser; pattern is bh-<slug>.
BH_CONTAINER_NAME=bh-my-app

# Browser Harness Patchright image; keep the tag aligned with the kit Patchright version.
BH_IMAGE=browser-harness-patchright:1.61.1

# OPTIONAL: force a Docker platform if operators need it. Leave unset for the native Docker platform.
# Docker Desktop/Colima on Apple Silicon usually works best unset with the image's system Chromium fallback.
# Native Linux amd64 operators may set linux/amd64 when using a Chrome-channel image variant.
# BH_DOCKER_PLATFORM=linux/amd64

# Localhost-only CDP host port; use 19322 by default, or another unused 19322+ port.
BH_HOST_PORT=19322

# browser-harness daemon name; keep this aligned with BH_PROJECT_SLUG.
BH_BU_NAME=my-app

# Docker named volume for this project's isolated Chrome profile only.
BH_PROFILE_VOLUME=bh-my-app-profile

# Project-relative download directory mounted from the container browser.
BH_DOWNLOADS_DIR=.browser-harness/downloads

# Docker Desktop-friendly shared-memory default; native Linux may prefer --ipc=host.
BH_DOCKER_EXTRA_ARGS=--shm-size=2g

# 0 runs headed Chrome under Xvfb; set to 1 only when operators want headless Chrome.
PATCHRIGHT_HEADLESS=0

# OPTIONAL: Run Chrome headless instead of headed under Xvfb.
# PATCHRIGHT_HEADLESS=1

# OPTIONAL: Informational browser origin shown by ./scripts/bh status. This never navigates Chrome.
# Use only a canonical HTTP(S) origin without credentials, path, query, or fragment.
# BH_BROWSER_ORIGIN=https://localhost:3443

# OPTIONAL: Dedicated Chromium host resolver rules, passed as exactly one browser argument.
# Quote values containing spaces. Do not duplicate this flag in PATCHRIGHT_EXTRA_ARGS.
# BH_HOST_RESOLVER_RULES='MAP localhost host.docker.internal'

# OPTIONAL: Extra Chrome/Chromium flags; keep launch args minimal and avoid personal browser data.
# PATCHRIGHT_EXTRA_ARGS=--lang=en-US

# OPTIONAL: browser binary selection. The image defaults to system Chromium for amd64/arm64 portability.
# Set PATCHRIGHT_BROWSER_EXECUTABLE= and PATCHRIGHT_BROWSER_CHANNEL=chrome only for a Chrome-channel image variant.
# PATCHRIGHT_BROWSER_EXECUTABLE=/usr/bin/chromium
# PATCHRIGHT_BROWSER_CHANNEL=chrome

# OPTIONAL: Proxy from inside Chrome; Docker Desktop provides host.docker.internal,
# and the native-Linux wrapper adds host.docker.internal via host-gateway.
# PATCHRIGHT_EXTRA_ARGS=--proxy-server=http://host.docker.internal:8080

# OPTIONAL: Stronger native-Linux sandbox path when a complete seccomp profile is wired.
# Docker Desktop users should usually keep the shared-memory default above.
# BH_DOCKER_EXTRA_ARGS=--ipc=host --security-opt seccomp=<absolute-path-to-seccomp_profile.json>
# CHROMIUM_SANDBOX=1

# OPTIONAL: Loopback-only VNC view of the container display, for one-time
# interactive work an agent must not do for you (signing in to ChatGPT for
# Oracle consults, clearing a captcha). Requires headed Chrome. Leave unset when
# not in use; it is not needed for normal harness or Oracle runs.
# BH_VNC_PORT=15900

# OPTIONAL: steipete/oracle consults through this project's browser container
# (./scripts/oracle). Model and workflow defaults otherwise come from
# .oracle/config.json; the CDP target is always 127.0.0.1:${BH_HOST_PORT}.
# BH_ORACLE_MODEL=gpt-5.5-pro
# BH_ORACLE_EXTRA_ARGS=--heartbeat 30
