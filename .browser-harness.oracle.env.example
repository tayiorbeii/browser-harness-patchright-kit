# Dedicated Oracle browser lane example.
# Copy to .browser-harness.oracle.env; use only through ./scripts/oracle-lane.
# Never reuse shared-lane identity, port, container, or profile values.

BH_PROJECT_SLUG=browser_harness_chatgpt_oracle
BH_CONTAINER_NAME=bh-chatgpt-oracle
BH_IMAGE=browser-harness-patchright:1.61.1
BH_HOST_PORT=19323
BH_BU_NAME=browser_harness_chatgpt_oracle
BH_PROFILE_VOLUME=bh-chatgpt-oracle-profile
BH_DOWNLOADS_DIR=.browser-harness/oracle-downloads
BH_DOCKER_EXTRA_ARGS=--shm-size=512m

# Headful Chromium under Xvfb avoids ChatGPT/Cloudflare's headless challenge.
# VNC remains disabled unless an operator exports BH_VNC_PORT for one-time sign-in.
PATCHRIGHT_HEADLESS="${PATCHRIGHT_HEADLESS:-0}"
BH_VNC_PORT="${BH_VNC_PORT:-}"

# Browser-mode Oracle consults use the isolated profile; no API key is required.
BH_ORACLE_MODEL=gpt-5.5-pro
